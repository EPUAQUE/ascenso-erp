<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="catalogo-003-libro-biblico" author="ascenso-backend">
        <createTable tableName="libro_biblico">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="grupo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="titulo" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="orden_sugerido" type="SMALLINT"/>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="libro_biblico" baseColumnNames="grupo_id"
                referencedTableName="grupo" referencedColumnNames="id"
                constraintName="fk_libro_biblico_grupo" onDelete="RESTRICT"/>
    </changeSet>

    <!-- Placeholders para que el catálogo no quede vacío en el primer login — el
         supervisor completa el catálogo real después vía el admin
         (Navegantes/Pioneros/Seguidores/Exploradores, no Pre-Navegantes). -->
    <changeSet id="catalogo-003-seed-libros-placeholder" author="ascenso-backend">
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Navegantes')"/>
            <column name="titulo" value="Evangelio de Marcos"/>
            <column name="orden_sugerido" valueNumeric="1"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Navegantes')"/>
            <column name="titulo" value="Hechos de los Apóstoles"/>
            <column name="orden_sugerido" valueNumeric="2"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Pioneros')"/>
            <column name="titulo" value="Evangelio de Marcos"/>
            <column name="orden_sugerido" valueNumeric="1"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Pioneros')"/>
            <column name="titulo" value="Evangelio de Juan"/>
            <column name="orden_sugerido" valueNumeric="2"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Seguidores')"/>
            <column name="titulo" value="Hechos de los Apóstoles"/>
            <column name="orden_sugerido" valueNumeric="1"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Seguidores')"/>
            <column name="titulo" value="Romanos"/>
            <column name="orden_sugerido" valueNumeric="2"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Exploradores')"/>
            <column name="titulo" value="Evangelio de Juan"/>
            <column name="orden_sugerido" valueNumeric="1"/>
        </insert>
        <insert tableName="libro_biblico">
            <column name="grupo_id" valueComputed="(select id from grupo where nombre = 'Exploradores')"/>
            <column name="titulo" value="Romanos"/>
            <column name="orden_sugerido" valueNumeric="2"/>
        </insert>
    </changeSet>
</databaseChangeLog>
