<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Sin destacamento_id a propósito: los anuncios son siempre globales (visibles
         para todos los destacamentos), a diferencia de `actividad`. -->
    <changeSet id="actividades-002-anuncio" author="ascenso-backend">
        <createTable tableName="anuncio">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="titulo" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="TEXT"/>
            <column name="imagen_url" type="VARCHAR(255)"/>
            <column name="enlace_url" type="VARCHAR(255)"/>
            <column name="fecha_inicio_visible" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin_visible" type="DATE"/>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="creado_por" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="anuncio" baseColumnNames="creado_por"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_anuncio_creado_por" onDelete="RESTRICT"/>
    </changeSet>
</databaseChangeLog>
