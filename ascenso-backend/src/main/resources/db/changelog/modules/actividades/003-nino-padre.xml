<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Tabla puente muchos-a-muchos: qué usuarios (rol PADRE) pueden ver el progreso
         de qué niño. Clave primaria compuesta, sin id propio — es una asociación
         pura, no un agregado con identidad propia. -->
    <changeSet id="actividades-003-nino-padre" author="ascenso-backend">
        <createTable tableName="nino_padre">
            <column name="nino_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="nino_padre" columnNames="nino_id, usuario_id" constraintName="pk_nino_padre"/>
        <addForeignKeyConstraint
                baseTableName="nino_padre" baseColumnNames="nino_id"
                referencedTableName="nino" referencedColumnNames="id"
                constraintName="fk_nino_padre_nino" onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="nino_padre" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_nino_padre_usuario" onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
