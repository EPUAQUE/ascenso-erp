<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="ninos-009-logro-mayor" author="ascenso-backend">
        <createTable tableName="logro_mayor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nino_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_logro_mayor_nino"/>
            </column>
            <column name="fecha_otorgada" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="logro_mayor" baseColumnNames="nino_id"
                referencedTableName="nino" referencedColumnNames="id"
                constraintName="fk_logro_mayor_nino" onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
