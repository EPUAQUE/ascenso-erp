<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="ninos-001-nino" author="ascenso-backend">
        <createTable tableName="nino">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="destacamento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nombre_completo" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_nacimiento" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="foto_url" type="VARCHAR(255)"/>
            <column name="encargado_nombre" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="encargado_contacto" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="contacto_emergencia" type="VARCHAR(50)"/>
            <column name="fecha_ingreso" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="grupo_actual_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="anio_programa_actual_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nino" baseColumnNames="destacamento_id"
                referencedTableName="destacamento" referencedColumnNames="id"
                constraintName="fk_nino_destacamento" onDelete="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="nino" baseColumnNames="grupo_actual_id"
                referencedTableName="grupo" referencedColumnNames="id"
                constraintName="fk_nino_grupo_actual" onDelete="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="nino" baseColumnNames="anio_programa_actual_id"
                referencedTableName="anio_programa" referencedColumnNames="id"
                constraintName="fk_nino_anio_programa_actual" onDelete="RESTRICT"/>
        <createIndex indexName="ix_nino_destacamento" tableName="nino">
            <column name="destacamento_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
