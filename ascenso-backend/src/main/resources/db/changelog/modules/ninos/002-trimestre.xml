<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="ninos-002-trimestre" author="ascenso-backend">
        <createTable tableName="trimestre">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="anio_calendario" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_inicio" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                tableName="trimestre" columnNames="anio_calendario, numero" constraintName="ux_trimestre_anio_numero"/>
        <sql>ALTER TABLE trimestre ADD CONSTRAINT ck_trimestre_numero CHECK (numero BETWEEN 1 AND 4);</sql>
    </changeSet>
</databaseChangeLog>
